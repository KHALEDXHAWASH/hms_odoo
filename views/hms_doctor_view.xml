<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="hms_doctor_list_view" model="ir.ui.view">
        <field name="name">hms.doctor.list</field>
        <field name="model">hms.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hms_doctor_form_view" model="ir.ui.view">
        <field name="name">hms.doctor.form</field>
        <field name="model">hms.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="ref"/>
                    </h1>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="department_id"/>
                        </group>

                        <group>
                            <field name="image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Patients">
                            <field name="patient_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="hms_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hms.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>