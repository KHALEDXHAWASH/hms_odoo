<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hms_patient_list_view" model="ir.ui.view">
        <field name="name">hms.patient.list</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="blood_type"/>
            </list>
        </field>
    </record>
    <record id="hms_patient_form_view" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <header>
                            <button name="status_action_undetermined"
                                    type="object"
                                    string="Undetermined"
                                    invisible="status == 'undetermined'"/>

                            <button name="status_action_fine"
                                    type="object"
                                    string="Fine"
                                    invisible="status in ['fine','good']"/>

                            <button name="status_action_good"
                                    type="object"
                                    string="Good"
                                    invisible="status == 'good'"/>

                            <button name="status_action_serious"
                                    type="object"
                                    string="Serious"
                                    invisible="status == 'serious'"/>

                        </header>
                        <field name="status" widget="statusbar"/>
                    </h1>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="email"/>
                            <field name="blood_type"/>
                        </group>

                        <group>
                            <field name="address"/>

                            <field name="history"
                                   invisible="age &lt; 50"/>

                            <field name="department_id"
                                   domain="[('is_opened', '=', True)]"/>

                            <field name="department_capacity"
                                   readonly="1"/>

                            <field name="doctor_ids"
                                   widget="many2many_tags"
                                   readonly="not department_id"
                                   domain="[('department_id', '=', department_id)]"
                                   groups="hms.hms_manager"
                            />

                            <field name="pcr"/>

                            <field name="cr_ratio"
                                   required="pcr"/>

                            <field name="image"
                                   widget="image"
                                   class="oe_avatar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="History">
                            <field name="log_ids">
                                <list>
                                    <field name="created_by"/>
                                    <field name="created_at"/>
                                    <field name="history"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>


    <record id="hms_patient_action" model="ir.actions.act_window">
        <field name="name">HMS</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>